// ASE WMS — base schema (grows from ERD:
// https://agustindevelops.atlassian.net/wiki/spaces/ASE/pages/165216257)
// Identity: Firebase Auth uid → User.firebaseUid
// Authorization: OrganizationMembership + Role (not a global User.role)
// Tenant boundary: organizationId from verified Firebase custom claim
// Domain data lives here; Prisma client + DATABASE_URL are server-only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tenant. Catalog, warehouses, orders, and memberships belong here.
model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  contactEmail String?
  websiteUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          OrganizationMembership[]
  addresses            Address[]
  warehouses           Warehouse[]
  locationUnits        LocationUnit[]
  items                Item[]
  inventoryStocks      InventoryStock[]
  files                File[]
  qrCodes              QrCode[]
  orders               EventOrder[]
  orderLines           OrderLine[]
  orderLineAllocations OrderLineAllocation[]
  issues               Issue[]
}

/// App user mirrored from Firebase Auth after Bearer verification.
model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  membership    OrganizationMembership?
  files         File[]
  createdOrders EventOrder[]
  issues        Issue[]
}

/// Organization-scoped role. Seed ADMIN for MVP; Staff is deferred.
model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  memberships OrganizationMembership[]
}

/// Authorization scope: a user is an admin of an organization they belong to.
/// MVP: one membership per user (UNIQUE userId).
model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String   @unique
  roleId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId])
  @@index([roleId])
}

/// Physical address for a warehouse. Fields stay optional for a barebones bootstrap.
model Address {
  id             String  @id @default(cuid())
  organizationId String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  zipcode        String?
  country        String?

  organization Organization @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse?

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  addressId      String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id])
  address       Address          @relation(fields: [addressId, organizationId], references: [id, organizationId])
  locationUnits LocationUnit[]
  stocks        InventoryStock[]

  @@unique([id, organizationId])
  @@unique([addressId, organizationId])
  @@index([organizationId])
}

/// Lookup: inventory classification (CHAIR, TABLE, …). Category may be null on Item.
model ItemCategory {
  id   String @id @default(cuid())
  code String @unique
  name String

  items Item[]
}

/// Catalog SKU owned by an organization. Quantities live on InventoryStock.
model Item {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  categoryId      String?
  qrCodeId        String?  @unique
  description     String?
  material        String?
  unitRentalPrice Decimal? @db.Decimal(12, 2)
  purchaseLink    String?
  replacementCost Decimal? @db.Decimal(12, 2)
  condition       String?
  disposition     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  category     ItemCategory?    @relation(fields: [categoryId], references: [id])
  qrCode       QrCode?          @relation(fields: [qrCodeId, organizationId], references: [id, organizationId])
  files        File[]
  stocks       InventoryStock[]
  orderLines   OrderLine[]
  issues       Issue[]

  @@unique([id, organizationId])
  @@unique([qrCodeId, organizationId])
  @@index([organizationId])
  @@index([categoryId])
}

/// Location-specific owned/available quantity for a catalog item.
model InventoryStock {
  id                 String   @id @default(cuid())
  organizationId     String
  itemId             String
  warehouseId        String
  locationUnitId     String?
  quantityOwned      Int      @default(0)
  quantityAvailable  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id])
  item         Item                  @relation(fields: [itemId, organizationId], references: [id, organizationId])
  warehouse    Warehouse             @relation(fields: [warehouseId, organizationId], references: [id, organizationId])
  locationUnit LocationUnit?         @relation(fields: [locationUnitId, organizationId], references: [id, organizationId])
  allocations  OrderLineAllocation[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([locationUnitId])
}

/// Catalog / inventory image. itemId is optional until attached after verify.
/// uploadedByUserId is the owner scope for sign/verify/delete (security pattern).
model File {
  id                  String    @id @default(cuid())
  organizationId      String
  itemId              String?
  uploadedByUserId    String
  s3Key               String
  contentType         String
  byteSize            Int?
  /// created | uploaded
  status              String
  signatureExpiration DateTime?
  publicUrl           String?
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  item         Item?        @relation(fields: [itemId, organizationId], references: [id, organizationId])
  uploadedBy   User         @relation(fields: [uploadedByUserId], references: [id])

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([itemId])
  @@index([uploadedByUserId])
  @@index([status])
  @@index([s3Key])
}

/// Lookup: WAREHOUSE, ZONE, AISLE, RACK, SHELF, WALL. Hierarchy rules are application constants.
model LocationUnitType {
  id   String @id @default(cuid())
  code String @unique
  name String

  locationUnits LocationUnit[]
}

/// Nested warehouse location. Always scoped by organizationId + warehouseId.
model LocationUnit {
  id                   String   @id @default(cuid())
  organizationId       String
  warehouseId          String
  parentLocationUnitId String?
  locationUnitTypeId   String
  name                 String
  label                String?
  qrCodeId             String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse        @relation(fields: [warehouseId, organizationId], references: [id, organizationId])
  parent       LocationUnit?    @relation("LocationUnitTree", fields: [parentLocationUnitId, organizationId], references: [id, organizationId])
  children     LocationUnit[]   @relation("LocationUnitTree")
  type         LocationUnitType @relation(fields: [locationUnitTypeId], references: [id])
  qrCode       QrCode?          @relation(fields: [qrCodeId, organizationId], references: [id, organizationId])
  stocks       InventoryStock[]

  @@unique([id, organizationId])
  @@unique([qrCodeId, organizationId])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([warehouseId, parentLocationUnitId])
  @@index([parentLocationUnitId])
  @@index([locationUnitTypeId])
}

/// Lookup: code 0 = item, code 1 = warehouse location unit.
model QrCodeType {
  id   String @id @default(cuid())
  code Int    @unique
  name String

  qrCodes QrCode[]
}

model QrCode {
  id             String   @id @default(cuid())
  organizationId String
  payload        String   @unique
  typeId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  type         QrCodeType    @relation(fields: [typeId], references: [id])
  locationUnit LocationUnit?
  item         Item?

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([typeId])
}

/// Lookup: PAID, PICKED_UP, RETURNED.
model OrderStatus {
  id   String @id @default(cuid())
  code String @unique
  name String

  orders EventOrder[]
}

/// Event rental order. Organization-owned; not warehouse-owned.
model EventOrder {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  eventDate       DateTime? @db.Date
  statusId        String
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  status       OrderStatus  @relation(fields: [statusId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])
  lines        OrderLine[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([statusId])
  @@index([createdByUserId])
}

/// Requested inventory on an event order. Fulfillment qty lives on OrderLineAllocation.
model OrderLine {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String
  itemId         String
  qtyRequested   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id])
  order        EventOrder            @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  item         Item                  @relation(fields: [itemId, organizationId], references: [id, organizationId])
  allocations  OrderLineAllocation[]
  issues       Issue[]

  @@unique([id, organizationId])
  @@unique([orderId, itemId])
  @@index([organizationId])
  @@index([orderId])
  @@index([itemId])
}

/// Fulfillment of an order line from a specific inventory stock location.
model OrderLineAllocation {
  id               String   @id @default(cuid())
  organizationId   String
  orderLineId      String
  inventoryStockId String
  qtyAllocated     Int      @default(0)
  qtyPicked        Int      @default(0)
  qtyReturned      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id])
  orderLine      OrderLine      @relation(fields: [orderLineId, organizationId], references: [id, organizationId], onDelete: Cascade)
  inventoryStock InventoryStock @relation(fields: [inventoryStockId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([orderLineId, inventoryStockId])
  @@index([organizationId])
  @@index([orderLineId])
  @@index([inventoryStockId])
}

/// Missing or broken quantity recorded during return. Never restores owned qty.
model Issue {
  id              String   @id @default(cuid())
  organizationId  String
  type            String
  itemId          String
  orderLineId     String?
  quantity        Int
  notes           String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  item         Item         @relation(fields: [itemId, organizationId], references: [id, organizationId])
  orderLine    OrderLine?   @relation(fields: [orderLineId, organizationId], references: [id, organizationId])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([itemId])
  @@index([orderLineId])
  @@index([createdByUserId])
}
