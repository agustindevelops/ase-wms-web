// ASE WMS — base schema (grows from ERD:
// https://agustindevelops.atlassian.net/wiki/spaces/ASE/pages/165216257)
// Identity: Firebase Auth uid → User.firebaseUid
// Authorization: WarehouseMembership + Role (not a global User.role)
// Domain data lives here; Prisma client + DATABASE_URL are server-only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// App user mirrored from Firebase Auth after Bearer verification.
model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships   WarehouseMembership[]
  files         File[]
  createdOrders EventOrder[]
}

/// Warehouse-scoped role. Seed ADMIN for MVP; Staff is deferred.
model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  memberships WarehouseMembership[]
}

/// Physical address for a warehouse. Fields stay optional for a barebones bootstrap.
model Address {
  id           String  @id @default(cuid())
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zipcode      String?
  country      String?

  warehouse Warehouse?
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  addressId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address       Address               @relation(fields: [addressId], references: [id])
  memberships   WarehouseMembership[]
  items         Item[]
  locationUnits LocationUnit[]
}

/// Authorization scope: a user is an admin of a warehouse they belong to.
model WarehouseMembership {
  id          String   @id @default(cuid())
  warehouseId String
  userId      String
  roleId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, warehouseId])
  @@index([warehouseId])
  @@index([userId])
  @@index([roleId])
}

/// Lookup: inventory classification (CHAIR, TABLE, …). Category may be null on Item.
model ItemCategory {
  id   String @id @default(cuid())
  code String @unique
  name String

  items Item[]
}

/// Inventory item owned by a warehouse.
model Item {
  id                String   @id @default(cuid())
  warehouseId       String
  name              String
  quantityOwned     Int      @default(0)
  quantityAvailable Int      @default(0)
  categoryId        String?
  locationUnitId    String?
  qrCodeId          String?  @unique
  description       String?
  material          String?
  unitRentalPrice   Decimal? @db.Decimal(12, 2)
  purchaseLink      String?
  replacementCost   Decimal? @db.Decimal(12, 2)
  condition         String?
  disposition       String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  category     ItemCategory? @relation(fields: [categoryId], references: [id])
  locationUnit LocationUnit? @relation(fields: [locationUnitId], references: [id])
  qrCode       QrCode?       @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  files        File[]
  orderLines   OrderLine[]

  @@index([warehouseId])
  @@index([categoryId])
  @@index([locationUnitId])
}

/// Catalog / inventory image. itemId is optional until attached after verify.
/// uploadedByUserId is the owner scope for sign/verify/delete (security pattern).
model File {
  id                   String    @id @default(cuid())
  itemId               String?
  uploadedByUserId     String
  s3Key                String
  contentType          String
  byteSize             Int?
  /// created | uploaded
  status               String
  signatureExpiration  DateTime?
  publicUrl            String?
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  item       Item? @relation(fields: [itemId], references: [id])
  uploadedBy User  @relation(fields: [uploadedByUserId], references: [id])

  @@index([itemId])
  @@index([uploadedByUserId])
  @@index([status])
  @@index([s3Key])
}

/// Lookup: WAREHOUSE, ZONE, AISLE, RACK, SHELF, WALL. Hierarchy rules are out of scope.
model LocationUnitType {
  id   String @id @default(cuid())
  code String @unique
  name String

  locationUnits LocationUnit[]
}

/// Nested warehouse location. Always scoped by warehouseId to prevent boundary crossover.
model LocationUnit {
  id                   String   @id @default(cuid())
  warehouseId          String
  parentLocationUnitId String?
  locationUnitTypeId   String
  name                 String
  label                String?
  qrCodeId             String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  parent    LocationUnit?    @relation("LocationUnitTree", fields: [parentLocationUnitId], references: [id])
  children  LocationUnit[]   @relation("LocationUnitTree")
  type      LocationUnitType @relation(fields: [locationUnitTypeId], references: [id])
  qrCode    QrCode?          @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  items     Item[]

  @@index([warehouseId])
  @@index([warehouseId, parentLocationUnitId])
  @@index([parentLocationUnitId])
  @@index([locationUnitTypeId])
}

/// Lookup: code 0 = item, code 1 = warehouse location unit.
model QrCodeType {
  id   String @id @default(cuid())
  code Int    @unique
  name String

  qrCodes QrCode[]
}

model QrCode {
  id        String   @id @default(cuid())
  payload   String   @unique
  typeId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type         QrCodeType    @relation(fields: [typeId], references: [id])
  locationUnit LocationUnit?
  item         Item?

  @@index([typeId])
}

/// Lookup: PAYMENT_PENDING, PAID, SETUP_INPROGRESS, SETUP_FULFILLED, TEARDOWN_STARTED, COMPLETE.
model OrderStatus {
  id   String @id @default(cuid())
  code String @unique
  name String

  orders EventOrder[]
}

/// Event rental order. Not warehouse-owned; lines may reference items from any warehouse.
model EventOrder {
  id              String    @id @default(cuid())
  name            String
  eventDate       DateTime? @db.Date
  statusId        String
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  status    OrderStatus @relation(fields: [statusId], references: [id])
  createdBy User        @relation(fields: [createdByUserId], references: [id])
  lines     OrderLine[]

  @@index([statusId])
  @@index([createdByUserId])
}

/// Requested inventory on an event order. qtyPicked/qtyReturned are fulfillment, not web-editable.
model OrderLine {
  id           String   @id @default(cuid())
  orderId      String
  itemId       String
  qtyRequested Int
  qtyPicked    Int      @default(0)
  qtyReturned  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order EventOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item       @relation(fields: [itemId], references: [id])

  @@unique([orderId, itemId])
  @@index([orderId])
  @@index([itemId])
}
