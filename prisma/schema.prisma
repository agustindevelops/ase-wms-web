// ASE WMS — base schema (grows from ERD:
// https://agustindevelops.atlassian.net/wiki/spaces/ASE/pages/165216257)
// Identity: Firebase Auth uid → User.firebaseUid
// Authorization: WarehouseMembership + Role (not a global User.role)
// Domain data lives here; Prisma client + DATABASE_URL are server-only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// App user mirrored from Firebase Auth after Bearer verification.
model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships WarehouseMembership[]
  files       File[]
}

/// Warehouse-scoped role. Seed ADMIN for MVP; Staff is deferred.
model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  memberships WarehouseMembership[]
}

/// Physical address for a warehouse. Fields stay optional for a barebones bootstrap.
model Address {
  id           String  @id @default(cuid())
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zipcode      String?
  country      String?

  warehouse Warehouse?
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  addressId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address     Address               @relation(fields: [addressId], references: [id])
  memberships WarehouseMembership[]
  items       Item[]
}

/// Authorization scope: a user is an admin of a warehouse they belong to.
model WarehouseMembership {
  id          String   @id @default(cuid())
  warehouseId String
  userId      String
  roleId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, warehouseId])
  @@index([warehouseId])
  @@index([userId])
  @@index([roleId])
}

/// Inventory item owned by a warehouse. Lookup FKs (category/location/QR) land later.
model Item {
  id                String   @id @default(cuid())
  warehouseId       String
  name              String
  quantityOwned     Int      @default(0)
  quantityAvailable Int      @default(0)
  description       String?
  material          String?
  unitRentalPrice   Decimal? @db.Decimal(12, 2)
  purchaseLink      String?
  replacementCost   Decimal? @db.Decimal(12, 2)
  condition         String?
  disposition       String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  files     File[]

  @@index([warehouseId])
}

/// Catalog / inventory image. itemId is optional until attached after verify.
/// uploadedByUserId is the owner scope for sign/verify/delete (security pattern).
model File {
  id                   String    @id @default(cuid())
  itemId               String?
  uploadedByUserId     String
  s3Key                String
  contentType          String
  byteSize             Int?
  /// created | uploaded
  status               String
  signatureExpiration  DateTime?
  publicUrl            String?
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  item       Item? @relation(fields: [itemId], references: [id])
  uploadedBy User  @relation(fields: [uploadedByUserId], references: [id])

  @@index([itemId])
  @@index([uploadedByUserId])
  @@index([status])
  @@index([s3Key])
}
