// ASE WIS — base schema (grows from ERD:
// https://agustindevelops.atlassian.net/wiki/spaces/ASE/pages/165216257)
// Identity: Firebase Auth uid → User.firebaseUid
// Authorization: OrganizationMembership + Role (not a global User.role)
// Tenant boundary: organizationId from verified Firebase custom claim
// Domain data lives here; Prisma client + DATABASE_URL are server-only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tenant. Catalog, warehouses, orders, and memberships belong here.
model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  contactEmail String?
  websiteUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          OrganizationMembership[]
  addresses            Address[]
  warehouses           Warehouse[]
  locationUnits        LocationUnit[]
  items                Item[]
  inventoryStocks      InventoryStock[]
  files                File[]
  qrCodes              QrCode[]
  orders               EventOrder[]
  orderItems           OrderItem[]
  orderItemAllocations OrderItemAllocation[]
  issues               Issue[]
  userActivities       UserActivity[]
  packages             Package[]
  packageItems         PackageItem[]
  packageFiles         PackageFile[]
  contacts             Contact[]
  orderDetails         OrderDetails[]
  clientTableDetails   ClientTableDetails[]
  orderUploads         OrderUpload[]
}

/// App user mirrored from Firebase Auth after Bearer verification.
model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  membership     OrganizationMembership?
  files          File[]
  createdOrders  EventOrder[]
  issues         Issue[]
  userActivities UserActivity[]
}

/// Organization-scoped role. Seed ADMIN for MVP; Staff is deferred.
model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  memberships OrganizationMembership[]
}

/// Authorization scope: a user is an admin of an organization they belong to.
/// MVP: one membership per user (UNIQUE userId).
model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String   @unique
  roleId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId])
  @@index([roleId])
}

/// Physical address for a warehouse or an event order venue.
/// Fields stay optional for a barebones bootstrap.
model Address {
  id             String  @id @default(cuid())
  organizationId String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  zipcode        String?
  country        String?

  organization Organization @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse?
  order        EventOrder?

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  addressId      String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id])
  address       Address          @relation(fields: [addressId, organizationId], references: [id, organizationId])
  locationUnits LocationUnit[]
  stocks        InventoryStock[]

  @@unique([id, organizationId])
  @@unique([addressId, organizationId])
  @@index([organizationId])
}

/// Lookup: inventory classification (CHAIR, TABLE, …). Category may be null on Item.
model ItemCategory {
  id   String @id @default(cuid())
  code String @unique
  name String

  items Item[]
}

/// Catalog SKU owned by an organization. Quantities live on InventoryStock.
model Item {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  categoryId      String?
  qrCodeId        String?  @unique
  description     String?
  material        String?
  unitRentalPrice Decimal? @db.Decimal(12, 2)
  purchaseLink    String?
  replacementCost Decimal? @db.Decimal(12, 2)
  condition       String?
  disposition     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  category     ItemCategory?    @relation(fields: [categoryId], references: [id])
  qrCode       QrCode?          @relation(fields: [qrCodeId, organizationId], references: [id, organizationId])
  files        File[]
  stocks       InventoryStock[]
  orderItems   OrderItem[]
  packageItems PackageItem[]
  issues       Issue[]

  @@unique([id, organizationId])
  @@unique([qrCodeId, organizationId])
  @@index([organizationId])
  @@index([categoryId])
  /// Fuzzy item search (pg_trgm).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Item_name_trgm_idx")
}

/// Location-specific owned/available quantity for a catalog item.
model InventoryStock {
  id                String   @id @default(cuid())
  organizationId    String
  itemId            String
  warehouseId       String
  locationUnitId    String?
  quantityOwned     Int      @default(0)
  quantityAvailable Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id])
  item         Item                  @relation(fields: [itemId, organizationId], references: [id, organizationId])
  warehouse    Warehouse             @relation(fields: [warehouseId, organizationId], references: [id, organizationId])
  locationUnit LocationUnit?         @relation(fields: [locationUnitId, organizationId], references: [id, organizationId])
  allocations  OrderItemAllocation[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([locationUnitId])
}

/// Uploaded image. itemId is optional until attached after verify.
/// Package media links through PackageFile, not a column here.
/// uploadedByUserId is the owner scope for sign/verify/delete (security pattern).
model File {
  id                  String    @id @default(cuid())
  organizationId      String
  itemId              String?
  uploadedByUserId    String
  s3Key               String
  contentType         String
  byteSize            Int?
  /// created | uploaded
  status              String
  signatureExpiration DateTime?
  publicUrl           String?
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  item         Item?        @relation(fields: [itemId, organizationId], references: [id, organizationId])
  uploadedBy   User         @relation(fields: [uploadedByUserId], references: [id])
  packageFile  PackageFile?

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([itemId])
  @@index([uploadedByUserId])
  @@index([status])
  @@index([s3Key])
}

/// Lookup: WAREHOUSE, ZONE, AISLE, RACK, SHELF, WALL. Hierarchy rules are application constants.
model LocationUnitType {
  id   String @id @default(cuid())
  code String @unique
  name String

  locationUnits LocationUnit[]
}

/// Nested warehouse location. Always scoped by organizationId + warehouseId.
model LocationUnit {
  id                   String   @id @default(cuid())
  organizationId       String
  warehouseId          String
  parentLocationUnitId String?
  locationUnitTypeId   String
  name                 String
  label                String?
  qrCodeId             String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse        @relation(fields: [warehouseId, organizationId], references: [id, organizationId])
  parent       LocationUnit?    @relation("LocationUnitTree", fields: [parentLocationUnitId, organizationId], references: [id, organizationId])
  children     LocationUnit[]   @relation("LocationUnitTree")
  type         LocationUnitType @relation(fields: [locationUnitTypeId], references: [id])
  qrCode       QrCode?          @relation(fields: [qrCodeId, organizationId], references: [id, organizationId])
  stocks       InventoryStock[]

  @@unique([id, organizationId])
  @@unique([qrCodeId, organizationId])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([warehouseId, parentLocationUnitId])
  @@index([parentLocationUnitId])
  @@index([locationUnitTypeId])
}

/// Lookup: code 0 = item, code 1 = warehouse location unit.
model QrCodeType {
  id   String @id @default(cuid())
  code Int    @unique
  name String

  qrCodes QrCode[]
}

model QrCode {
  id             String   @id @default(cuid())
  organizationId String
  payload        String   @unique
  typeId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  type         QrCodeType    @relation(fields: [typeId], references: [id])
  locationUnit LocationUnit?
  item         Item?

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([typeId])
}

/// Reusable grouped offering shown on the customer site. Offering only: it does
/// not reserve inventory. Ordering a package copies its items onto OrderItem.
model Package {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// URL segment on the customer site: /at-home-experiences/{slug}.
  slug           String
  /// Markdown shown on the customer-site package card.
  summary        String?  @db.VarChar(1024)
  /// Markdown.
  description    String?  @db.Text
  basePriceCents Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  items        PackageItem[]
  files        PackageFile[]
  orders       EventOrder[]

  @@unique([id, organizationId])
  @@unique([organizationId, slug])
  @@index([organizationId])
}

/// Catalog item and quantity included in a package.
model PackageItem {
  id             String   @id @default(cuid())
  organizationId String
  packageId      String
  itemId         String
  quantity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  package      Package      @relation(fields: [packageId, organizationId], references: [id, organizationId], onDelete: Cascade)
  item         Item         @relation(fields: [itemId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([packageId, itemId])
  @@index([organizationId])
  @@index([packageId])
  @@index([itemId])
}

/// Package media: a verified image or video upload, ordered by sortOrder.
model PackageFile {
  id             String   @id @default(cuid())
  organizationId String
  packageId      String
  fileId         String   @unique
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  package      Package      @relation(fields: [packageId, organizationId], references: [id, organizationId], onDelete: Cascade)
  file         File         @relation(fields: [fileId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@unique([fileId, organizationId])
  @@index([organizationId])
  @@index([packageId])
}

/// Lookup: PAYMENT_PENDING, PAYMENT_PROCESSED, PAID, PICKED_UP, RETURNED.
/// Fulfillment rank (PAID → PICKED_UP → RETURNED) lives in orderStatus.ts.
model OrderStatus {
  id   String @id @default(cuid())
  code String @unique
  name String

  orders EventOrder[]
}

/// Event rental order. Organization-owned; not warehouse-owned.
/// createdByUserId is null for orders placed through the public intake API.
model EventOrder {
  id                      String    @id @default(cuid())
  organizationId          String
  name                    String
  eventDate               DateTime? @db.Date
  eventStartTime          DateTime? @db.Time(0)
  eventEndTime            DateTime? @db.Time(0)
  guestCount              Int?
  /// Cents. Amount quoted by the customer site; not recomputed here.
  quote                   Int?
  statusId                String
  createdByUserId         String?
  contactId               String?   @unique
  addressId               String?   @unique
  /// Reference only. Business rules use OrderItem rows.
  packageId               String?
  stripeCheckoutSessionId String?   @unique
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  status             OrderStatus         @relation(fields: [statusId], references: [id])
  createdBy          User?               @relation(fields: [createdByUserId], references: [id])
  contact            Contact?            @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Restrict)
  address            Address?            @relation(fields: [addressId, organizationId], references: [id, organizationId], onDelete: Restrict)
  package            Package?            @relation(fields: [packageId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  details            OrderDetails?
  clientTableDetails ClientTableDetails?
  uploads            OrderUpload[]

  @@unique([id, organizationId])
  @@unique([contactId, organizationId])
  @@unique([addressId, organizationId])
  @@index([organizationId])
  @@index([statusId])
  @@index([createdByUserId])
  @@index([packageId])
}

/// Customer contact for a single order. Not a shared directory.
model Contact {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String
  phone          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  order        EventOrder?

  @@unique([id, organizationId])
  @@index([organizationId])
}

/// Operational fulfillment details for an order.
model OrderDetails {
  id                   String    @id @default(cuid())
  organizationId       String
  orderId              String    @unique
  setupStartsAt        DateTime?
  setupEndsAt          DateTime?
  pickupStartsAt       DateTime?
  pickupEndsAt         DateTime?
  isPrivateHome        Boolean   @default(false)
  outletsAvailable     Boolean   @default(false)
  /// STANDARD | SPECIAL
  accessType           String    @default("STANDARD")
  accessNotes          String?
  allowMarketingPhotos Boolean   @default(false)
  specialNotes         String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  order        EventOrder   @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@unique([orderId, organizationId])
  @@index([organizationId])
}

/// Present when the client supplies their own tables and chairs.
model ClientTableDetails {
  id              String   @id @default(cuid())
  organizationId  String
  orderId         String   @unique
  /// RECTANGULAR | ROUND | SQUARE | OTHER
  tableShape      String
  tableDimensions String
  numberOfTables  Int
  numberOfChairs  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  order        EventOrder   @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@unique([orderId, organizationId])
  @@index([organizationId])
}

/// Customer-provided photo or document URL for fulfillment. Not a catalog File.
model OrderUpload {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String
  /// SETUP_SPACE | CLIENT_FURNITURE
  uploadType     String
  fileUrl        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  order        EventOrder   @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([orderId])
}

/// Requested inventory on an event order. Fulfillment qty lives on OrderItemAllocation.
model OrderItem {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String
  itemId         String
  qtyRequested   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id])
  order        EventOrder            @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  item         Item                  @relation(fields: [itemId, organizationId], references: [id, organizationId])
  allocations  OrderItemAllocation[]
  issues       Issue[]

  @@unique([id, organizationId])
  @@unique([orderId, itemId])
  @@index([organizationId])
  @@index([orderId])
  @@index([itemId])
}

/// Fulfillment of an order item from a specific inventory stock location.
model OrderItemAllocation {
  id               String   @id @default(cuid())
  organizationId   String
  orderItemId      String
  inventoryStockId String
  qtyAllocated     Int      @default(0)
  qtyPicked        Int      @default(0)
  qtyReturned      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id])
  orderItem      OrderItem      @relation(fields: [orderItemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  inventoryStock InventoryStock @relation(fields: [inventoryStockId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([orderItemId, inventoryStockId])
  @@index([organizationId])
  @@index([orderItemId])
  @@index([inventoryStockId])
}

/// Missing or broken quantity recorded during return. Never restores owned qty.
model Issue {
  id              String   @id @default(cuid())
  organizationId  String
  type            String
  itemId          String
  orderItemId     String?
  quantity        Int
  notes           String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  item         Item         @relation(fields: [itemId, organizationId], references: [id, organizationId])
  orderItem    OrderItem?   @relation(fields: [orderItemId, organizationId], references: [id, organizationId])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([itemId])
  @@index([orderItemId])
  @@index([createdByUserId])
}

/// Org-scoped log of warehouse/admin writes for dashboard activity.
model UserActivity {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String
  action         String
  entityType     String
  entityId       String?
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User         @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, actorUserId])
}
