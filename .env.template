# Copy to .env.local and fill in values:
#   cp .env.template .env.local
#
# Never commit .env / .env.local. Secrets stay server-only (no NEXT_PUBLIC_* for DB/Admin).

# =============================================================================
# Prisma / Postgres (server only) — get these from Prisma Console after create-db
# =============================================================================
# Direct TCP URL (postgres:// or postgresql://). Required for @prisma/adapter-pg.
# Prisma Console → your project → Connect → "Direct TCP" / connection string.
# If the console shows prisma+postgres://, switch to the TCP connection string.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional: Prisma Data Platform / Accelerate API key (if you enable Accelerate later).
# Not required for the ASE-9 TCP adapter setup.
# PRISMA_API_KEY=

# =============================================================================
# Firebase (client) — SAME Firebase project as ase-wms-app
# =============================================================================
# Firebase Console → Project settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional (Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# Firebase Admin (server only) — verify Bearer ID tokens from web or ase-wms-app
# =============================================================================
# Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_ADMIN_PROJECT_ID usually matches NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste private key with escaped newlines:
# "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=
# Or local file path (do not commit the JSON):
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json

# =============================================================================
# Public site / branding
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_SITE_URL=https://aniahsocialevents.com

# =============================================================================
# Cloudflare R2 (inventory media — ASE-11)
# Only these three are required. Server-only — never NEXT_PUBLIC_*.
# =============================================================================
# Address: https://<accountId>.r2.cloudflarestorage.com/<bucket>
S3_API_URL=
# Cloudflare → R2 → Manage API Tokens → Object Read & Write
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_ACCESS_KEY=


# =============================================================================
# Optional: Contentful
# =============================================================================
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_WEBHOOK_SECRET=

# =============================================================================
# Dev helpers
# =============================================================================
NEXT_PUBLIC_SHOW_LOGGER=false
