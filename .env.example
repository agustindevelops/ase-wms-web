# Copy to .env.local and fill in values:
#   cp .env.example .env.local

# =============================================================================
# Firebase (client) — share the SAME Firebase project with ase-wms-app
# =============================================================================
# Client config values are not secret; Auth + Security Rules protect data.
# Using one Firebase project lets web + mobile share users and ID tokens —
# no separate "cross-reference token" is required for Firebase Auth itself.
# Register a Web app in Firebase Console if you do not already have one.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional (Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# Firebase Admin (server only) — verify ID tokens from web or ase-wms-app
# =============================================================================
# Prefer a service-account JSON string or path. Never expose these to the client.
# FIREBASE_ADMIN_PROJECT_ID can match NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with escaped newlines: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=
# Or point at a downloaded service-account JSON file (local only; do not commit):
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json

# =============================================================================
# Cross-app / WMS API (ase-wms-app ↔ ase-wms-web)
# =============================================================================
# Base URL for any backend this admin UI or the mobile app calls.
# Leave blank until your API exists; helpers can no-op when unset.
ASE_WMS_API_URL=http://localhost:3001
# Optional shared secret for machine-to-machine calls (header: x-ase-api-key).
# Prefer verifying Firebase ID tokens instead of a static key when possible.
ASE_WMS_API_KEY=
# Public API origin for browser-side fetches (if different from ASE_WMS_API_URL).
NEXT_PUBLIC_ASE_WMS_API_URL=http://localhost:3001

# =============================================================================
# Public site / branding
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_SITE_URL=https://aniahsocialevents.com

# =============================================================================
# Optional: AWS S3 (gallery / inventory media — same bucket pattern as marketing site)
# =============================================================================
S3_BUCKET_NAME=
S3_AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =============================================================================
# Optional: Contentful (if this admin reads marketing CMS content)
# =============================================================================
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_WEBHOOK_SECRET=

# =============================================================================
# Dev helpers
# =============================================================================
NEXT_PUBLIC_SHOW_LOGGER=false
