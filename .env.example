# Copy to .env.local and fill in values:
#   cp .env.template .env.local
#
# Prefer .env.template as the canonical checklist. This file mirrors it.

# =============================================================================
# Prisma / Postgres (server only) — get these from Prisma Console after create-db
# =============================================================================
# Direct TCP URL (postgres:// or postgresql://). Required for @prisma/adapter-pg.
# Prisma Console → your project → Connect → "Direct TCP" / connection string.
# If the console shows prisma+postgres://, switch to the TCP connection string.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional: Prisma Data Platform / Accelerate API key (if you enable Accelerate later).
# Not required for the ASE-9 TCP adapter setup.
# PRISMA_API_KEY=

# =============================================================================
# Firebase (client) — SAME Firebase project as ase-wms-app
# =============================================================================
# Firebase Console → Project settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional (Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# Firebase Admin (server only) — verify Bearer ID tokens from web or ase-wms-app
# =============================================================================
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the full JSON on one line. Keep \n inside private_key. Never NEXT_PUBLIC_*.
FIREBASE_ADMIN_CREDENTIALS_JSON='{"type":"service_account","project_id":"..."}'

# =============================================================================
# Public site / branding
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_SITE_URL=https://aniahsocialevents.com

# =============================================================================
# Public customer-site API (/api/public/{organizationId}/*) and Stripe webhook
# =============================================================================
# Stripe webhook only: organization that receives payment updates.
# Defaults to aniah-social-events. Public routes take the organization id in the path.
PUBLIC_ORGANIZATION_SLUG=aniah-social-events
# Comma-separated browser origins allowed to call /api/public/{organizationId}/*.
# Defaults to NEXT_PUBLIC_MARKETING_SITE_URL.
PUBLIC_API_ALLOWED_ORIGINS=https://aniahsocialevents.com,https://www.aniahsocialevents.com
# Seconds public GET responses stay in the Next data cache (default 300, max 10800, 0 = off).
# Package edits in admin clear it immediately.
PUBLIC_CACHE_TIMER=300
# Stripe restricted key (rk_…) with write access to Checkout Sessions.
# Server only — used to open Checkout for /api/public/{organizationId}/orders.
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → endpoint /api/stripe/webhook → Signing secret.
# Subscribe to checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Cloudflare R2 (inventory media — ASE-11)
# Only these three are required. Server-only — never NEXT_PUBLIC_*.
# S3_API_URL = address (endpoint + bucket), not a secret by itself.
# Keys from Cloudflare → R2 → Manage API Tokens → Object Read & Write.
# =============================================================================
S3_API_URL=https://<accountId>.r2.cloudflarestorage.com/<bucket>
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_ACCESS_KEY=


# =============================================================================
# Optional: Contentful
# =============================================================================
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_WEBHOOK_SECRET=

# =============================================================================
# Dev helpers
# =============================================================================
NEXT_PUBLIC_SHOW_LOGGER=false
